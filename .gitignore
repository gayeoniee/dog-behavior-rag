# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# uv
.uv/

# 환경 변수 (.env.example만 커밋)
.env
.env.*
!.env.example

# 테스트/린트 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 수집 데이터 (저작물 원본·산출물은 커밋하지 않는다.
#  sources.yaml / coverage_questions.yaml 은 커밋 대상)
#   ⚠️ `data/raw/`가 아니라 `data/raw/*`여야 한다. 디렉터리째 제외하면 git이
#   그 안으로 들어가지 않아서 **아래 예외 줄이 읽히지도 않는다.** 처음에 그렇게
#   써놓고 정제본이 커밋되는 줄 알았는데, 실제로는 예전에 -f로 강제로 넣은
#   파일 하나가 추적되고 있었을 뿐이다(추적 중인 파일에는 gitignore가 안 걸린다).
#   다음 소스를 커밋하려다 거부당하고서야 알았다.
data/raw/*
# LLM 정제 결과(보듬TV 자막 파생물)도 커밋하지 않는다 (2026-09-15).
#   기기 이동용으로 한때 커밋했지만, 공개 레포에 타인 저작물의 파생물을 올리는 건
#   "개인 이용" 라이선스 범위를 넘는다. 히스토리에서도 지웠다. 기기를 옮기면
#   파일을 직접 복사하거나 refine_transcripts를 다시 돌린다.
data/processed/
models/
.cache/

# 내장 Postgres 데이터 디렉터리 (scripts.db.serve — Docker 없는 머신용)
.pgdata/

# Next.js
web/node_modules/
web/.next/
web/out/

# 에디터
.vscode/
.idea/
.DS_Store

# 프롬프트 A/B 산출물 (실험 중간물)
data/eval_results/refine_prompts/
