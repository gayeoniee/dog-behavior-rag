# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# uv
.uv/

# 환경 변수 (.env.example만 커밋)
.env
.env.*
!.env.example

# 테스트/린트 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 수집 데이터 (저작물 원본·산출물은 커밋하지 않는다.
#  sources.yaml / coverage_questions.yaml 은 커밋 대상)
#   ⚠️ `data/raw/`가 아니라 `data/raw/*`여야 한다. 디렉터리째 제외하면 git이
#   그 안으로 들어가지 않아서 **아래 예외 줄이 읽히지도 않는다.** 처음에 그렇게
#   써놓고 정제본이 커밋되는 줄 알았는데, 실제로는 예전에 -f로 강제로 넣은
#   파일 하나가 추적되고 있었을 뿐이다(추적 중인 파일에는 gitignore가 안 걸린다).
#   다음 소스를 커밋하려다 거부당하고서야 알았다.
data/raw/*
# 예외: LLM 정제 결과는 커밋한다.
#   원본 자막과 달리 이건 **재생성에 API 할당량이 드는 파생물**이다.
#   기기를 옮길 때(학원 PC ↔ 집 PC) 이게 없으면 Gemini 할당량을 다시 써야 하고,
#   할당량은 하루 단위라 그날 작업이 막힌다. 분량도 작다(24편에 52KB).
!data/raw/*.refined.json
data/processed/
models/
.cache/

# 내장 Postgres 데이터 디렉터리 (scripts.db.serve — Docker 없는 머신용)
.pgdata/

# Next.js
web/node_modules/
web/.next/
web/out/

# 에디터
.vscode/
.idea/
.DS_Store
