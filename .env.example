# 이 파일을 .env 로 복사해서 사용하세요: cp .env.example .env

APP_ENV=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ── Database (pgvector) ────────────────────────────────
# docker compose up -d db 로 띄우면 아래 값 그대로 동작.
# Docker가 없거나 관리자 권한이 없는 머신은 내장 서버를 쓴다:
#   uv sync --extra pgdev && uv run python -m scripts.db.serve
# 이때 포트가 매번 바뀌므로 serve가 아래 DATABASE_URL을 직접 갱신한다.
DATABASE_URL=postgresql+asyncpg://gyrag:gyrag@localhost:5432/gyrag

# ── Provider 선택 ──────────────────────────────────────
# LLM: huggingface(스텁) | openai-compatible
# openai-compatible은 서비스가 아니라 프로토콜이다 — LM Studio / Ollama /
# llama.cpp / vLLM / Groq / OpenRouter가 전부 같은 규격이라 URL만 바꾸면 된다.
LLM_PROVIDER=openai-compatible
EMBEDDING_PROVIDER=huggingface

# ── LLM 서버 ───────────────────────────────────────────
# openai-compatible은 프로토콜이라 아래 셋 중 아무거나 URL만 바꾸면 된다.
#
# (A) Gemini 무료 티어 — 빠르고 VRAM을 안 먹는다 ★ 지금 기본값
#     키 발급: https://aistudio.google.com/apikey (무료, 카드 등록 불필요)
#     장점: GPU를 임베딩이 독점할 수 있다 — 로컬 LLM과 VRAM 6GB를 다투지 않는다.
#     단점: 질의가 외부로 나간다. 무료 티어는 보통 제품 개선에 사용된다.
#
#     모델 id 주의: gemini-3.1-flash는 없다. 3.1은 flash-lite만 있다.
#       gemini-3.1-flash-lite  ← 현재 설정. 이 프로젝트가 LLM에 시키는 일이
#                                작아서(질의 재작성 30토큰) 이걸로 충분하다
#       gemini-3.6-flash       ← 현재 stable Flash. 분별이 필요한 작업
#                                (팩트체크 판정 등)에서 부족하면 여기로 올린다
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
#     ⚠️ 키는 여기 넣지 마세요. 이 파일은 .gitignore 예외라 **커밋됩니다**.
#        키는 .env 에만 넣으세요 (그쪽은 커밋 안 됨).
LLM_API_KEY=
#
# (B) LM Studio (로컬, 완전 무료·오프라인)
#     Developer 탭 → Start Server. VRAM 6GB면 7B Q4까지.
#     적재를 동시에 돌리면 OOM이므로 EMBEDDING_DEVICE=cpu로 두거나 번갈아 쓴다.
#     LLM_BASE_URL=http://localhost:1234/v1
#     LLM_MODEL=qwen2.5-7b-instruct
#     LLM_API_KEY=not-needed
#
# (C) Ollama
#     LLM_BASE_URL=http://localhost:11434/v1
#
# HF Inference API를 안 쓰는 이유: 무료 크레딧이 월 $0.10라 사실상 못 쓰고,
# hf-inference는 2025-07부터 CPU 추론 위주로 축소돼 최신 instruct 모델이 없다.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
# 근거 기반 답변이라 창의성이 필요 없다. 낮을수록 자료에서 덜 벗어난다.
LLM_TEMPERATURE=0.2

# ── 질의 재작성 ────────────────────────────────────────
# 한국어 질문을 영어 기술표현으로 바꿔서 검색한다.
# bge-m3가 주제는 교차언어로 넘나드는데 기법 명칭은 못 넘기 때문 —
# "복종 자세 강제 유지" 0.552(무관) → 영어 재작성 0.724(AVSAB 지배이론).
# LLM 서버가 꺼져 있으면 원문으로 폴백하므로 꺼도 검색은 동작한다.
QUERY_REWRITE_ENABLED=true

# ── HuggingFace ────────────────────────────────────────
# 모델은 내일 데이터 보고 확정. bge-m3는 한국어 성능 좋은 무료 임베딩 모델
HF_EMBEDDING_MODEL=BAAI/bge-m3
HF_LLM_MODEL=
# 로컬 실행만 할 거면 비워둬도 됨 (Inference API 쓸 때만 필요)
HF_API_TOKEN=

# ── Anthropic (provider 전환 시에만 사용, 지금은 미사용) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── 임베딩 ─────────────────────────────────────────────
# EMBEDDING_DIM은 chunks.embedding 컬럼 차원과 같아야 한다. 모델을 바꾸면
# 이 값을 고치고 반드시 `scripts.db.init --drop`으로 테이블을 다시 만들 것.
EMBEDDING_DIM=1024
# auto | cuda | cpu.  실측(RTX 3050): GPU가 CPU보다 11배 빠르다
#   (11,281청크 재적재 = CPU 163분 vs GPU 15분)
# ⚠️ VRAM을 LLM과 나눠 쓰면 OOM 난다. 6GB에 7B Q4(4.7GB) + bge-m3(2.3GB)는 안 들어간다.
#    LM Studio를 켠 채 적재하려면 cpu로, 적재만 할 거면 LM Studio를 내리고 auto로.
# torch가 CPU 빌드면 auto여도 CPU다. 확인: uv run python -c "import torch;print(torch.cuda.is_available())"
#   CUDA 빌드 설치: uv pip install --index-url https://download.pytorch.org/whl/cu126 --upgrade torch
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_SEQ_LENGTH=1024
# 적재는 오프라인 CLI가 하므로, 검색을 안 쓰고 API만 띄울 땐 false로 기동을 가볍게
EMBEDDING_WARMUP=true

# ── 청킹 ───────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
CHUNK_MIN_SIZE=200

# ── 검색 파라미터 ──────────────────────────────────────
TOP_K=5
# authority_tier 부스팅 상한. 근소한 차이만 뒤집는 타이브레이커 (설계 의도)
AUTHORITY_BOOST=0.02
# 문서당 반환 청크 상한 — AAHA 가이드라인 한 건이 top_k를 독점하는 걸 막는다
MAX_CHUNKS_PER_DOCUMENT=3
# 재랭킹 전 과다 조회 배수
CANDIDATE_MULTIPLIER=4

# ── CORS (Next.js 화면 / 안드로이드 앱 연동) ────────────
# web/의 Next.js 개발 서버가 localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# LAN에서 열 때(휴대폰으로 확인 등) 오리진이 http://192.168.x.x:3000 이 된다.
# IP가 DHCP로 바뀌므로 목록에 박지 않고 사설 대역을 정규식으로 연다.
# 이 경우 API도 LAN에 노출해야 한다:
#   uv run uvicorn app.main:app --host 0.0.0.0 --reload
#   web/.env.local 에 NEXT_PUBLIC_API_BASE=http://<내 IP>:8000
# ⚠️ 같은 네트워크의 다른 기기에서 API가 보이게 된다. 신뢰할 수 있는 망에서만.
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+|192\.168\.\d+\.\d+):3000
